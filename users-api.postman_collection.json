{
  "info": {
    "_postman_id": "b7e2c4d0-users-api",
    "name": "Users API (Back_End)",
    "description": "GET list users, POST create profile + PDF, PATCH replace PDF. Import in Postman / Insomnia / Thunder Client.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "List users (JSON)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "Create user + PDF",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "fullName", "value": "Ada Lovelace", "type": "text" },
            { "key": "email", "value": "ada@example.com", "type": "text" },
            { "key": "phone", "value": "0812345678", "type": "text" },
            { "key": "pdf", "type": "file", "src": [] }
          ]
        },
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "Update PDF only",
      "request": {
        "method": "PATCH",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "pdf", "type": "file", "src": [] }]
        },
        "url": "{{baseUrl}}/api/users/{{userId}}/pdf"
      }
    }
  ]
}
