PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
# Database in Atlas → Browse Collections (default without /dbname in URI is "test"). Change if your data is under another name.
MONGO_DB=user
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=your_jwt_super_secret_key_here
# Access Token expiry (short-lived JWT) — e.g. 15m, 30m, 1h
ACCESS_TOKEN_EXPIRY=15m
# Refresh Token expiry in days (long-lived, stored in MongoDB)
REFRESH_TOKEN_EXPIRY_DAYS=30

# ── Google OAuth 2.0 ───────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Allowed email domain suffix for Google login (Thai university standard)
GOOGLE_OAUTH_ALLOWED_DOMAIN=

# ── Frontend & CORS ────────────────────────────────────────────────────────
# Comma-separated allowed frontend URLs (e.g., Vercel frontend or local)
FRONTEND_URL=http://localhost:5173,https://udvc-research.online

# ── Session (used only for OAuth handshake state) ─────────────────────────────
SESSION_SECRET=your_session_secret_here

# ── Rate Limiting & Proxy ──────────────────────────────────────────────────
# Set TRUST_PROXY=1 when running behind reverse proxies like Render, Heroku, Cloudflare, Vercel
TRUST_PROXY=1
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_AUTH_MAX=30
