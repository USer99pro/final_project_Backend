PORT=
MONGO_URI=
# Database in Atlas → Browse Collections (default without /dbname in URI is "test"). Change if your data is under another name.
MONGO_DB=
MONGO_DNS_SERVERS=
JWT_SECRET=
# Access Token expiry (short-lived JWT) — e.g. 15m, 30m, 1h
ACCESS_TOKEN_EXPIRY=15m
# Refresh Token expiry in days (long-lived, stored in MongoDB)
REFRESH_TOKEN_EXPIRY_DAYS=30

# ── Google OAuth 2.0 ───────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CALLBACK_URL=
# Allowed email domain suffix for Google login (Thai university standard)
GOOGLE_OAUTH_ALLOWED_DOMAIN=

# ── Session (used only for OAuth handshake state) ─────────────────────────────
# ── Rate Limiting & Proxy ──────────────────────────────────────────────────
# Set TRUST_PROXY=1 when running behind reverse proxies like Render, Heroku, Cloudflare
TRUST_PROXY=1
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_AUTH_MAX=30
SESSION_SECRET=
