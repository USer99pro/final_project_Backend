    {
      "name": "Auth",
      "description": "Authentication endpoints.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.collectionVariables.set(\"bearerToken\", response.token);",
                  "    console.log(\"Token automatically saved to bearerToken variable\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"6400000001\",\n  \"fullName\": \"Jane Doe\",\n  \"major\": \"Computer Science\",\n  \"email\": \"jane.d@example.com\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
